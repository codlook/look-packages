// example.lk — using the barcode package.  Run it:  lk example.lk

use "pkg/barcode/barcode.lk"

// 1. The easy way — text or code in, SVG out.
file::put("sku.svg", barcode("LOOK-8691234"));

// 2. With control — exact pixel size (width/height) and color. The SVG scales to fit.
file::put("sku-sized.svg", barcode_svg("8691234567890", [
    "width"  => 400,
    "height" => 90,
    "dark"   => "#1a1a2e"
]));

print("wrote sku.svg and sku-sized.svg — open or scan them");

// 3. EAN-13 retail product code. Pass 12 digits; the check digit is appended for you.
print("full code : " . ean13_normalize("400638133393"));   // 4006381333931
print("check     : " . ean13_checkdigit("400638133393"));  // 1
file::put("product.svg", ean13("400638133393"));           // number rendered below the bars
file::put("product-big.svg", ean13_svg("869012345678", ["scale" => 3, "height" => 100]));

// 4. Grab the SVG as a plain string — assign it, print it, return it from a route.
$ornekBarkod = barcode("ORDER-42");
print($ornekBarkod);

// 5. Serve either kind live from a route (uncomment inside an lk-fcgi app):
//
