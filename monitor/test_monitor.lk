# monitor paketi — biçim testi (CLI, use ile). Prometheus tip doğruluğu + JSON alanları.
use "monitor.lk"
use string

$p = monitor_prometheus()
# counter'lar 'counter', gauge'lar 'gauge' tiplemeli (Grafana rate() için kritik)
print(string::contains($p, "# TYPE look_requests_total counter") ? "OK counter-tip" : "FAIL counter-tip")
print(string::contains($p, "# TYPE look_db_pool_busy gauge") ? "OK gauge-tip" : "FAIL gauge-tip")
print(string::contains($p, "# HELP look_errors_5xx_total") ? "OK help-satiri" : "FAIL help-satiri")

$j = monitor_json()
print($j["request_count"] != null ? "OK json-request_count" : "FAIL json")
print($j["vm_disabled_routes"] != null ? "OK json-vm_disabled_routes" : "FAIL json")
